# Demo mode — no backend, no network.
#
# Copy to .env.local for local development:
#   cp .env.demo.example .env.local
#
# On Vercel, set VITE_DEMO_MODE=true as a project environment variable and
# leave VITE_API_URL unset.
#
# The value is compared against the literal string "true". VITE_DEMO_MODE=1 or
# =yes will NOT enable demo mode, and anything other than "true" leaves
# VITE_API_URL required — which is the point: nothing here turns on by accident.
VITE_DEMO_MODE=true

# Must be unset or empty in demo mode. Nothing reads it, and no request is made.
# VITE_API_URL=
